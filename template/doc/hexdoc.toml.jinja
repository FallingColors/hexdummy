modid = "{{ modid }}"
book = "hexcasting:thehexbook"

resource_dirs = [  # top takes priority
    "resources",
    "{$_common.src}/main/resources",
    { path="{$_common.src}/generated/resources", required=false },
    "{$_fabric.src}/main/resources",
    { path="{$_fabric.src}/generated/resources", required=false },
    "{$_forge.src}/main/resources",
    { path="{$_forge.src}/generated/resources", required=false },
    { modid="hexcasting" },
    { modid="minecraft" },
    { modid="hexdoc" },
]
export_dir = "src/hexdoc_{{ modid }}/_export/generated"

[template]
icon = "{$_common.src}/main/resources/assets/{{ modid }}/icon.png"
include = [
    "{{ modid }}",
    "hexcasting",
    "hexdoc",
]

[template.args]
mod_name = "{{ display_name }}"
author = "{{ github_user }}"
show_landing_text = false

[extra.hexcasting]
# NOTE: "!Raw" means "don't apply variable interpolation to this value"
_pattern_regex = { "!Raw"='make\("(?P<name>[^"]+)",\s*HexDir\.(?P<startdir>\w+),\s*"(?P<signature>[qweasd]+)"' }

[[extra.hexcasting.pattern_stubs]]
path = "{$_common.kotlin}/registry/{{ classname }}Actions.kt"
regex = "{^_pattern_regex}"

# platforms

[_common]
src = "../{{ common_path }}/src"
java = "{src}/main/java/{{ package_path }}"
kotlin = "{src}/main/kotlin/{{ package_path }}"

[_fabric]
src = "../{{ fabric_path }}/src"
java = "{src}/main/java/{{ package_path }}/fabric"
kotlin = "{src}/main/kotlin/{{ package_path }}/fabric"

[_forge]
src = "../{{ forge_path }}/src"
java = "{src}/main/java/{{ package_path }}/forge"
kotlin = "{src}/main/kotlin/{{ package_path }}/forge"
