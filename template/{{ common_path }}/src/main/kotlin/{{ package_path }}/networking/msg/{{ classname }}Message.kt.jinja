}

sealed interface {{ classname }}MessageS2C : {{ classname }}Message {
    fun sendToPlayer(player: ServerPlayer) {
        {{ classname }}Networking.CHANNEL.sendToPlayer(player, this)
    }

    fun sendToPlayers(players: Iterable<ServerPlayer>) {
