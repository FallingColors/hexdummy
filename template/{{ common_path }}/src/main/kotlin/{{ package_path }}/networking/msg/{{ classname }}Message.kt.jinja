sealed interface {{ classname }}MessageCompanion<T : {{ classname }}Message> {
    val type: Class<T>

    fun decode(buf: FriendlyByteBuf): T

    fun T.encode(buf: FriendlyByteBuf)

    fun apply(msg: T, supplier: Supplier<PacketContext>) {
        val ctx = supplier.get()
        when (ctx.env) {
            EnvType.SERVER, null -> {
                {{ classname }}.LOGGER.debug("Server received packet from {}: {}", ctx.player.name.string, this)
                when (msg) {
                    is {{ classname }}MessageC2S -> msg.applyOnServer(ctx)
                    else -> {{ classname }}.LOGGER.warn("Message not handled on server: {}", msg::class)
                }
            }
            EnvType.CLIENT -> {
                {{ classname }}.LOGGER.debug("Client received packet: {}", this)
                when (msg) {
                    is {{ classname }}MessageS2C -> msg.applyOnClient(ctx)
                    else -> {{ classname }}.LOGGER.warn("Message not handled on client: {}", msg::class)
                }
            }
        }
    }

    fun register(channel: NetworkChannel) {
        channel.register(type, { msg, buf -> msg.encode(buf) }, ::decode, ::apply)
    }
}
